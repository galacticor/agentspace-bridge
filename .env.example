# Optional Environment Variables for IOH Agentspace Bridge
# Copy to .env if you want to override defaults (all values below are optional)

# IOH Agentspace Portal & Engine Configuration
AGENTSPACE_ENTRY_URL=https://agentspace.ioh.co.id
AGENTSPACE_CONFIG_ID=384c42b0-2885-415a-82d5-f2babc063b6e
AGENTSPACE_MODEL=gemini-4-argon
AGENTSPACE_THINKING=MEDIUM

# Browser channel for Playwright SSO token refresh ("msedge" or "chrome")
# Defaults automatically to "msedge" on Windows and "chrome" on macOS
# AGENTSPACE_BROWSER=msedge

# Custom path to store/load agentspace_xsrf.json (defaults to ./agentspace_xsrf.json)
# AGENTSPACE_XSRF_PATH=./agentspace_xsrf.json

# Optional OneDrive Export Overrides (for Mode 3B OneDrive .pptx auto-upload)
# Leave blank to let the OneDrive connector use the agent's or logged-in user's parameters
# AGENTSPACE_ONEDRIVE_DRIVE_ID=
# AGENTSPACE_ONEDRIVE_PARENT_ID=
# AGENTSPACE_ONEDRIVE_DRIVE_NAME=OneDrive - Indosat Ooredoo Hutchison
# AGENTSPACE_ONEDRIVE_FOLDER_NAME=Agentspace_Exports

# Maximum AI image/video prompts per media session before auto-rotation (default: 3)
# AGENTSPACE_MAX_MEDIA_PROMPTS=3
